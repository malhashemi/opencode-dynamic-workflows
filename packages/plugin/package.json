{
  "name": "opencode-dynamic-workflows",
  "version": "0.1.0",
  "description": "OpenCode V2 plugin: deterministic multi-subagent Workflows with typed results, a live TUI panel, a web app and a versioned protocol.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts",
    "./workflow": "./src/workflow/index.ts",
    "./protocol": "./src/protocol/index.ts",
    "./rpc": "./src/service/rpc.ts",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "server.ts",
    "rpc.ts",
    "src",
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "bun run script/build-tui.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.16",
    "zod": "^4.1.8"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/client": "2.0.16",
    "@opencode/theme": "2.0.16",
    "@opentui/core": "0.5.12",
    "@opentui/solid": "0.5.12",
    "solid-js": "1.9.12"
  }
}
