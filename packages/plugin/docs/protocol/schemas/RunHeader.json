{
  "$id": "https://opencode-dynamic-workflows/protocol/v1/RunHeader.json",
  "title": "RunHeader",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string"
    },
    "workflow": {
      "type": "object",
      "properties": {
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "provenance": {
          "type": "string",
          "enum": [
            "durable",
            "inline"
          ]
        }
      },
      "required": [
        "key",
        "name",
        "description",
        "provenance"
      ],
      "additionalProperties": false
    },
    "location": {
      "type": "string"
    },
    "parentSessionID": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "stopped",
        "interrupted"
      ]
    },
    "waiting": {
      "type": "boolean"
    },
    "background": {
      "type": "boolean"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phasesDeclared": {
      "type": "boolean"
    },
    "currentPhase": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unit": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "subagent": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "unit",
          "prompt",
          "subagent",
          "error"
        ],
        "additionalProperties": false
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "tokens": {
          "type": "object",
          "properties": {
            "input": {
              "type": "number"
            },
            "output": {
              "type": "number"
            },
            "reasoning": {
              "type": "number"
            },
            "cacheRead": {
              "type": "number"
            },
            "cacheWrite": {
              "type": "number"
            }
          },
          "required": [
            "input",
            "output",
            "reasoning",
            "cacheRead",
            "cacheWrite"
          ],
          "additionalProperties": false
        },
        "cost": {
          "type": "number"
        }
      },
      "required": [
        "tokens",
        "cost"
      ],
      "additionalProperties": false
    },
    "tokensSpent": {
      "type": "number"
    },
    "budget": {
      "type": "object",
      "properties": {
        "total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "hard": {
          "type": "boolean"
        }
      },
      "required": [
        "total",
        "hard"
      ],
      "additionalProperties": false
    },
    "startedAt": {
      "type": "number"
    },
    "endedAt": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "resultPreview": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "resumeOf": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "cleanup": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "done"
      ]
    },
    "revision": {
      "type": "number"
    }
  },
  "required": [
    "runId",
    "workflow",
    "location",
    "parentSessionID",
    "status",
    "waiting",
    "background",
    "phases",
    "phasesDeclared",
    "currentPhase",
    "errors",
    "usage",
    "tokensSpent",
    "budget",
    "startedAt",
    "endedAt",
    "resultPreview",
    "resumeOf",
    "cleanup",
    "revision"
  ],
  "additionalProperties": false
}
