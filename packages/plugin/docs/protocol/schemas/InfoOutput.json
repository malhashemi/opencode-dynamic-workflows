{
  "$id": "https://opencode-dynamic-workflows/protocol/v1/InfoOutput.json",
  "title": "InfoOutput",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "number",
      "const": 1
    },
    "plugin": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "opencode": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxUnits": {
          "type": "number"
        },
        "maxItemsPerCall": {
          "type": "number"
        },
        "maxUnitSteps": {
          "type": "number"
        },
        "maxConcurrentUnits": {
          "type": "number"
        },
        "maxConcurrentRuns": {
          "type": "number"
        },
        "providerConcurrency": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "required": [
        "maxUnits",
        "maxItemsPerCall",
        "maxUnitSteps"
      ],
      "additionalProperties": false
    },
    "gateway": {
      "type": "object",
      "properties": {
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocol",
    "plugin",
    "opencode",
    "location",
    "capabilities",
    "limits",
    "gateway"
  ],
  "additionalProperties": false
}
