{
  "name": "opencode-dynamic-workflows-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Deterministic multi-subagent Workflow orchestration for OpenCode V2, as a plugin (no core changes).",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --build",
    "test": "bun test",
    "build": "bun run --cwd packages/plugin build",
    "verify:live": "bun test ./packages/plugin/test/live"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
